# SQLite is the default local database. It is created automatically on startup.
DATABASE_URL=sqlite+aiosqlite:///./finadvisor.db

# AI analysis only. Financial values are always calculated in Python.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=

# Optional runtime configuration
APP_ENV=development

# Windows + MSYS2 UCRT64 only. Required by WeasyPrint's Pango DLLs.
WEASYPRINT_DLL_DIRECTORIES=C:\msys64\ucrt64\bin
